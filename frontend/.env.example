# Copy this file to `.env` and adjust for your environment.
# `.env` is gitignored and is excluded from the Docker build context, so these
# values are NOT baked into the image — supply them at build or run time.
#
# Vite only exposes variables prefixed with VITE_ to browser code.

# Base URL for REST calls. Leave unset to use the relative default "/api",
# which works when the frontend is served from the same origin as the API.
#   local dev : http://localhost:5000/api
#   deployed  : http://<your-ec2-public-ip>:5000/api
VITE_API_BASE_URL=http://localhost:5000/api

# Origin the Socket.IO client connects to (no /api suffix).
#   local dev : http://localhost:5000
#   deployed  : http://<your-ec2-public-ip>:5000
VITE_BASE_URL=http://localhost:5000
