# Copy this file to `.env` and fill in real values.
# `.env` is gitignored and must never be committed.

# ---- Server ----
# Port the Express/Socket.IO server listens on.
PORT=5000

# "development" or "production". In development the auth cookie is sent over
# plain HTTP; anything else marks it Secure (HTTPS only).
NODE_ENV=development

# Origin allowed by CORS, for both the REST API and the Socket.IO handshake.
# Must exactly match the URL the browser loads the frontend from — including
# the port, and with no trailing slash.
#   local dev : http://localhost:5173
#   deployed  : http://<your-ec2-public-ip>:5173
ORIGIN=http://localhost:5173

# Minimum winston log level to emit. One of: error, warn, info, debug.
LOG_LEVEL=info

# ---- Database ----
# MongoDB connection string (MongoDB Atlas or a self-hosted instance).
MONGO=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/realtimechat

# ---- Auth ----
# Secret used to sign JWTs. Use a long random string, not a dictionary word.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# ---- Cloudinary (profile pictures and image messages) ----
# From your Cloudinary dashboard: https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=your-api-secret
